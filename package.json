{
  "name": "e-jdr-backend",
  "version": "1.0.0",
  "description": "Backend E-JDR — Node.js + TypeScript en Clean Architecture",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "ts-node -r tsconfig-paths/register db/umzug.ts up",
    "migrate:down": "ts-node -r tsconfig-paths/register db/umzug.ts down",
    "migrate:status": "ts-node -r tsconfig-paths/register db/umzug.ts status"
  },
  "keywords": [
    "clean-architecture",
    "typescript",
    "express",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
