{
  "name": "e-jdr-backend",
  "version": "1.1.0",
  "description": "Backend E-JDR — Node.js + TypeScript en Clean Architecture",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "serve": "npm run migrate:up && ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:eslint-rules": "node ./node_modules/typescript/bin/tsc -p eslint-rules/tsconfig.build.json",
    "lint": "npm run build:eslint-rules && eslint . --ignore-pattern 'eslint-rules/**' --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:up": "ts-node --transpile-only -r tsconfig-paths/register db/umzug.ts up",
    "migrate:down": "ts-node --transpile-only -r tsconfig-paths/register db/umzug.ts down",
    "migrate:status": "ts-node --transpile-only -r tsconfig-paths/register db/umzug.ts status",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "clean-architecture",
    "typescript",
    "express",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "pino": "^10.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.3",
    "semantic-release": "^24.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.2.6"
  }
}
