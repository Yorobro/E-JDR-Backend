# ═══════════════════════════════════════════════════════════════
# OPTIONNEL — uniquement si tu fais tourner le back + une BDD MySQL
# EN LOCAL. Pour développer le FRONT contre le back de dev (Vertex),
# rien à configurer ici : voir la section « Environnement de
# développement (Vertex) » du README. La BDD de dev vit sur Vertex
# et n'est pas joignable directement depuis ta machine.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Serveur HTTP
# ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ───────────────────────────────────────────────────────────────
# Base de données MySQL
# ───────────────────────────────────────────────────────────────
# Ces valeurs correspondent au docker-compose.yml fourni (docker compose up -d).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=e_jdr

# ───────────────────────────────────────────────────────────────
# JWT — secrets DISTINCTS pour access et refresh (obligatoire)
# Générer par ex. avec : openssl rand -hex 32
# ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_access
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_refresh

# Durées de vie des tokens
# Access token volontairement assez long (1h) : il est renouvelé silencieusement via
# /auth/refresh sans rotation du refresh token, ce qui supporte plusieurs appareils.
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
